# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and should never be committed.

# Secret key for admin access. Append to the URL: /admin?key=<value>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=

# Postgres connection string (Neon) — only needed if running against Postgres locally.
# In production, POSTGRES_PRISMA_URL is injected automatically by Vercel's Neon integration.
# When set, the app uses the Neon adapter instead of SQLite.
# POSTGRES_PRISMA_URL=
