# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and should never be committed.

# Secret key for admin access. Append to the URL: /admin?key=<value>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=

# Neon Postgres connection string.
# In production this is injected automatically by Vercel's Neon integration.
# For local dev, paste your Neon connection string here.
# For fully offline dev, use a local Postgres container instead:
#   docker run -p 5432:5432 -e POSTGRES_PASSWORD=local postgres:16
#   POSTGRES_PRISMA_URL=postgresql://postgres:local@localhost:5432/postgres
POSTGRES_PRISMA_URL=
