generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A unique invite token issued to a reviewer.
// Each token allows exactly one submission (normal or anonymous).
model ReviewToken {
  id           String              @id @default(cuid())
  token        String              @unique
  name         String // who it's for (admin's reference or self-identified)
  message      String? // optional message from requester explaining context
  status       String              @default("pending") // "requested" | "pending" | "submitted" | "anonymous"
  createdAt    DateTime            @default(now())
  usedAt       DateTime? // when the token was consumed (submitted or anonymous)
  expiresAt    DateTime? // optional expiry
  submissionId String?             @unique
  submission   FeedbackSubmission? @relation(fields: [submissionId], references: [id])
}

// A single submission from one reviewer.
model FeedbackSubmission {
  id          String             @id @default(cuid())
  submittedAt DateTime           @default(now())
  responses   FeedbackResponse[]
  reviewToken ReviewToken?
}

// One response per question answered within a submission.
model FeedbackResponse {
  id           String             @id @default(cuid())
  submissionId String
  submission   FeedbackSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionKey  String
  value        String
}
