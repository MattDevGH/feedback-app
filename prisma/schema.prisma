generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Provider is set to postgresql for the generated client.
// Locally, the SQLite adapter in src/lib/prisma.ts overrides the connection at runtime.
// The schema provider must match the production database type for correct query generation.
// Run migrations locally with DATABASE_PROVIDER override — see prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// A single submission from one reviewer.
model FeedbackSubmission {
  id          String             @id @default(cuid())
  submittedAt DateTime           @default(now())
  responses   FeedbackResponse[]
}

// One response per question answered within a submission.
// questionKey references a key in src/lib/questions.config.ts.
model FeedbackResponse {
  id           String             @id @default(cuid())
  submissionId String
  submission   FeedbackSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionKey  String
  value        String
}
