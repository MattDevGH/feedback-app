generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A unique invite token issued to a reviewer.
// Each token allows exactly one submission.
model ReviewToken {
  id           String              @id @default(cuid())
  token        String              @unique
  name         String // who it's for (admin's reference, e.g. "Alice")
  createdAt    DateTime            @default(now())
  expiresAt    DateTime? // optional expiry
  submissionId String?             @unique
  submission   FeedbackSubmission? @relation(fields: [submissionId], references: [id])
}

// A single submission from one reviewer.
model FeedbackSubmission {
  id          String             @id @default(cuid())
  submittedAt DateTime           @default(now())
  responses   FeedbackResponse[]
  reviewToken ReviewToken?
}

// One response per question answered within a submission.
// questionKey references a key in src/lib/questions.config.ts.
model FeedbackResponse {
  id           String             @id @default(cuid())
  submissionId String
  submission   FeedbackSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionKey  String
  value        String
}
